# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# CORS Configuration (comma-separated origins for production)
# Example: https://yourapp.com,https://admin.yourapp.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (set to 'production' in production)
ENVIRONMENT=development

# Groq API key for cloud tutor inference — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
